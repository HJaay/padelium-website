# Vercel KV (https://vercel.com/docs/storage/vercel-kv) — backs the
# waitlist email list. Can point at the same KV store as the backend
# service (it uses a distinct "waitlist:emails" set key, so there's no
# collision with the device-pairing data backend keeps there).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Absolute origin of the backend service (auth/billing), used to build the
# "Sign In" links on this site since it's a separate deployment.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Set to "true" to take the whole site offline behind a maintenance page
# (see src/middleware.ts). Leave unset/"false" to serve the site normally.
MAINTENANCE_MODE=false
